        "title": "Group Coaching",
        "post_content": "<!-- wp:cover {\"overlayColor\":\"leco-cp-primary\",\"isUserOverlayColor\":true,\"contentPosition\":\"center center\",\"isDark\":false,\"tagName\":\"header\",\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/header\",\"name\":\"Header\"},\"align\":\"full\",\"className\":\"title-section\"} -->\n<header class=\"wp-block-cover alignfull is-light title-section\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-leco-cp-primary-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:leco-cp/header-logo {\"logo\":{\"id\":\"{{attachment:content_0}}\",\"title\":\"Client Portal Logo - Dark\",\"filename\":\"Client-Portal-Logo-Dark.png\",\"url\":\"{{attachment_url:content_0}}\",\"link\":\"http://wordpress.test/?attachment_id=44\",\"alt\":\"\",\"author\":\"1\",\"description\":\"\",\"caption\":\"\",\"name\":\"client-portal-logo-dark\",\"status\":\"inherit\",\"uploadedTo\":42,\"date\":\"2026-02-02T19:27:55.000Z\",\"modified\":\"2026-02-02T19:27:55.000Z\",\"menuOrder\":0,\"mime\":\"image/png\",\"type\":\"image\",\"subtype\":\"png\",\"icon\":\"http://wordpress.test/wp-includes/images/media/default.svg\",\"dateFormatted\":\"February 2, 2026\",\"nonces\":{\"update\":\"26db441985\",\"delete\":\"e202fa9581\",\"edit\":\"3397531a5d\"},\"editLink\":\"http://wordpress.test/wp-admin/post.php?post=44\\u0026action=edit\",\"meta\":false,\"authorName\":\"lauradunn\",\"authorLink\":\"http://wordpress.test/wp-admin/profile.php\",\"uploadedToTitle\":\"Your Portal Name Here\",\"uploadedToLink\":\"http://wordpress.test/wp-admin/post.php?post=42\\u0026action=edit\",\"filesizeInBytes\":11359,\"filesizeHumanReadable\":\"11 KB\",\"context\":\"\",\"height\":264,\"width\":1364,\"orientation\":\"landscape\",\"sizes\":{\"thumbnail\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-150x150.png\",\"height\":150,\"width\":150,\"orientation\":\"landscape\"},\"medium\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-300x58.png\",\"height\":58,\"width\":300,\"orientation\":\"landscape\"},\"large\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-1024x198.png\",\"height\":198,\"width\":1024,\"orientation\":\"landscape\"},\"full\":{\"url\":\"{{attachment_url:content_0}}\",\"height\":264,\"width\":1364,\"orientation\":\"landscape\"}},\"compat\":{\"item\":\"\",\"meta\":\"\"}},\"fixedWidth\":true} /-->\n\n<!-- wp:post-title /-->\n\n<!-- wp:navigation {\"ref\":\"{{navigation:leco-cp-navigation}}\"} /--></div>\n<!-- /wp:group --></div></header>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"className\":\"content-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group content-section\"><!-- wp:paragraph -->\n<p>Six weeks, a small group, and one place to find the calls, the worksheets, and whatever you said you'd do before the next one.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">How the six weeks run</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>📞 One live call a week, ninety minutes</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>🎥 The recording's up the next day</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>📝 A worksheet between calls, and one thing you commit to out loud</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>💬 The group stays open the whole way through</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:leco-cp/general-information {\"insertBlocks\":false,\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/general-information\",\"name\":\"General Information\"}} /-->\n\n<!-- wp:leco-cp/project-status {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/project-status\",\"name\":\"Show project status\"}} -->\n<div class=\"wp-block-leco-cp-project-status alignwide leco-cp-cols-3 leco-cp-container\"><!-- wp:leco-cp/project-status-block {\"value\":\"3 of 6\",\"label\":\"Week\",\"backgroundColor\":\"leco-cp-secondary\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Thursday 7pm\",\"label\":\"Next call\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"September\",\"label\":\"Cohort\",\"backgroundColor\":\"leco-cp-tertiary\"} /--></div>\n<!-- /wp:leco-cp/project-status -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/phases-blocks\",\"name\":\"Phases Boxes\"},\"align\":\"full\",\"className\":\"main-content\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1024px\"}} -->\n<div class=\"wp-block-group alignfull main-content\"><!-- wp:leco-cp/search-bar {\"className\":\"wp-block-leco-cp-search-bar\"} /-->\n\n<!-- wp:leco-cp/phases {\"title\":\"Start here\",\"description\":\"Do these once, before the first call.\",\"phase\":\"\",\"uid\":0} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":0,\"phaseID\":\"d872538b-efd0-4c6f-b045-87b7fe4f731b\",\"icon\":\"clipboard\",\"status\":\"completed\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:group-coaching-gc-how-it-works}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">How this program works</span><span class=\"description\">How the six weeks run.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":1,\"phaseID\":\"1e2a1f49-2a49-4cee-aa1a-7e02b667db7c\",\"icon\":\"quill\",\"status\":\"completed\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:group-coaching-gc-before-first-call}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Before the first call</span><span class=\"description\">Three questions and a bit of setup.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":2,\"phaseID\":\"870a2be8-2447-4998-976a-02b08da1d2f7\",\"icon\":\"chat\",\"moduleLinks\":[{\"linkUrl\":\"#\",\"linkTitle\":\"Open the group space\"},{\"linkUrl\":\"#\",\"linkTitle\":\"Add the calls to your calendar\"}],\"textAbove\":\"\\u003cp\\u003eThe group space is for questions, progress, and whatever you said you'd do this week. Post there rather than saving it up for the call.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Join the group</span><span class=\"description\">Where the conversation happens between calls.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"The six weeks\",\"description\":\"One call a week. Recordings go up the day after.\",\"phase\":\"\",\"uid\":1} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":3,\"phaseID\":\"c3b280bb-1bd2-48d9-935e-6e770a3dcbac\",\"icon\":\"book-open\",\"status\":\"completed\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:group-coaching-gc-week-1}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 1: Getting clear</span><span class=\"description\">What you want, in one sentence.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":4,\"phaseID\":\"cfd5fb3b-a4c0-4227-bfc3-4a285df2e8d4\",\"icon\":\"book-open\",\"status\":\"completed\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:group-coaching-gc-week-2}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 2: Making it real</span><span class=\"description\">Turning the goal into dated actions.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":5,\"phaseID\":\"cf75fa9a-4406-45a8-9598-bd83db747f51\",\"icon\":\"book-open\",\"status\":\"active\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:group-coaching-gc-week-3}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 3: When it gets hard</span><span class=\"description\">What stops you, and how to interrupt it.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":6,\"phaseID\":\"2da6e615-c1a8-40b1-aeab-e2686866348a\",\"icon\":\"book-open\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 4: Building the system</span><span class=\"description\">Making the work a routine.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":7,\"phaseID\":\"a0161b5e-f208-4c4b-a583-5c7302070b29\",\"icon\":\"book-open\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 5: Making it stick</span><span class=\"description\">Keeping it going after the program ends.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":8,\"phaseID\":\"7990c2ff-88b3-428b-990f-6c9296d5ba75\",\"icon\":\"book-open\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 6: Where you go next</span><span class=\"description\">What to carry forward, and what to drop.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Resources and next steps\",\"description\":\"Open to everyone, the whole way through.\",\"phase\":\"\",\"uid\":2} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":9,\"phaseID\":\"7e393eee-3043-4d34-bd45-a033a1472ba4\",\"icon\":\"book\",\"moduleType\":\"module-files\",\"moduleFiles\":[{\"id\":\"{{attachment:content_1}}\",\"url\":\"{{attachment_url:content_1}}\",\"title\":\"Six week workbook\"},{\"id\":\"{{attachment:content_2}}\",\"url\":\"{{attachment_url:content_2}}\",\"title\":\"Week 1 worksheet\"},{\"id\":\"{{attachment:content_3}}\",\"url\":\"{{attachment_url:content_3}}\",\"title\":\"Week 2 worksheet\"},{\"id\":\"{{attachment:content_4}}\",\"url\":\"{{attachment_url:content_4}}\",\"title\":\"Week 3 worksheet\"}],\"textAbove\":\"\\u003cp\\u003eThe workbook covers all six weeks. Each week's worksheet goes up here when that week opens.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Workbook and worksheets</span><span class=\"description\">Everything to download in one place.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":10,\"phaseID\":\"343f95f0-882b-4746-846c-4f4a01630c9b\",\"icon\":\"settings\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:group-coaching-gc-recommended-tools}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Recommended tools</span><span class=\"description\">What past groups ended up using.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":11,\"phaseID\":\"1eb09cf6-2b5d-4e6e-b129-71e71b519017\",\"icon\":\"help\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:group-coaching-gc-common-questions}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Common questions</span><span class=\"description\">Answers to what gets asked most.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":12,\"phaseID\":\"49e9e410-8200-44b4-85e8-727255d50b83\",\"icon\":\"lightbulb\",\"moduleLinks\":[{\"linkUrl\":\"#\",\"linkTitle\":\"Join the next cohort\"},{\"linkUrl\":\"#\",\"linkTitle\":\"Work with me one to one\"}],\"textAbove\":\"\\u003cp\\u003eSome people run the program again with a new goal. Others move to one to one sessions.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003eBoth options stay open for a month after the program ends.\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">What happens next</span><span class=\"description\">Carrying on after week six.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/call-to-action\",\"name\":\"Call To Action\"},\"align\":\"full\",\"className\":\"cta-section\",\"backgroundColor\":\"leco-cp-primary\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull cta-section has-leco-cp-primary-background-color has-background\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"has-large-font-size\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"2rem\"}}},\"fontSize\":\"x-large\"} -->\n<p class=\"has-text-align-center has-large-font-size has-x-large-font-size\" style=\"margin-bottom:2rem\">Stuck on something this week?</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">Ask in the group</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/footer-contact\",\"name\":\"Footer Contact\"},\"align\":\"full\",\"className\":\"contacts\",\"backgroundColor\":\"leco-cp-tertiary\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull contacts has-leco-cp-tertiary-background-color has-background\"><!-- wp:list {\"fontSize\":\"small\"} -->\n<ul class=\"wp-block-list has-small-font-size\"><!-- wp:list-item -->\n<li>(123) 456-7890</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>hello@clientportal.io</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Powered by <a href=\"https://www.client-portal.io/\" target=\"_blank\" rel=\"noopener noreferrer\">Client Portal</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->",
