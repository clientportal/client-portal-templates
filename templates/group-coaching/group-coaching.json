			"ref_name": "gc-resources-and-next-steps",
			"title": "Resources and next steps",
			"post_name": "gc-resources-and-next-steps",
			"post_content": "<!-- wp:leco-cp/phases {\"title\":\"Resources and next steps\",\"description\":\"Open to everyone, the whole way through.\",\"phase\":\"\",\"uid\":2} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":9,\"phaseID\":\"15746d42-9635-44a0-97b0-4ae5260b7534\",\"icon\":\"book\",\"moduleType\":\"module-files\",\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e This module ships empty. Attach your worksheets, or switch it to a URLs module and point at wherever you host them. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Workbook and Worksheets</span><span class=\"description\">Everything to download in one place.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":10,\"phaseID\":\"39e8d62a-5061-4b60-8f56-3e1737b2d3a0\",\"icon\":\"settings\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:gc-recommended-tools}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Recommended Tools</span><span class=\"description\">What past cohorts actually stuck with.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":11,\"phaseID\":\"cccf414c-9b33-4a6b-bb68-4501fbacf52c\",\"icon\":\"help\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:gc-common-questions}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Common Questions</span><span class=\"description\">Answers to what gets asked most.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":12,\"phaseID\":\"fa2df2ea-690b-463d-96c3-126db9f89e67\",\"icon\":\"lightbulb\",\"moduleLinks\":[{\"linkUrl\":\"next-cohort-link\",\"linkTitle\":\"Join the next cohort\"},{\"linkUrl\":\"one-to-one-link\",\"linkTitle\":\"Work with me one to one\"}],\"textAbove\":\"\\u003cp\\u003eThe six weeks end, the work doesn't. Some people run it again with a new goal, others move to one to one sessions.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003eBoth options stay open for a month after the program ends.\\n\\n\\u003cstrong\\u003e⚡️ Quick tip:\\u003c/strong\\u003e One portal serves the whole cohort. Add every member to this same portal rather than making a copy each, and a change you make appears for everyone at once. \\u003ca href=\\u0022https://client-portal.io/support/how-to-add-clients-to-your-portals-updated-zmnw5\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to add clients to your portals\\u003c/a\\u003e. It also means nothing personal to one member belongs anywhere in here.\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">What Happens Next</span><span class=\"description\">Carrying on after week six.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->",
			"post_status": "publish"
		}
	]
