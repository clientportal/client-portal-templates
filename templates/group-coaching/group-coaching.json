		"title": "Group Coaching Template",
		"post_content": "<!-- wp:cover {\"overlayColor\":\"leco-cp-primary\",\"isUserOverlayColor\":true,\"contentPosition\":\"center center\",\"isDark\":false,\"tagName\":\"header\",\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/header\",\"name\":\"Header\"},\"align\":\"full\",\"className\":\"title-section\"} -->\n<header class=\"wp-block-cover alignfull is-light title-section\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-leco-cp-primary-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:leco-cp/header-logo /-->\n\n<!-- wp:post-title /-->\n\n<!-- wp:navigation {\"ref\":\"{{navigation:leco-cp-navigation}}\"} /--></div>\n<!-- /wp:group --></div></header>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"className\":\"content-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group content-section\"><!-- wp:paragraph -->\n<p>Six weeks, a small group, and one place to find the calls, the worksheets, and whatever you said you'd do before the next one.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">How the six weeks run</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>One live call a week, ninety minutes</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>The recording's up the next day</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>A worksheet between calls, and one thing you commit to out loud</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>The group stays open the whole way through</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:leco-cp/general-information {\"insertBlocks\":false,\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/general-information\",\"name\":\"General Information\"}} /-->\n\n<!-- wp:leco-cp/project-status {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/project-status\",\"name\":\"Show project status\"}} -->\n<div class=\"wp-block-leco-cp-project-status alignwide leco-cp-cols-3 leco-cp-container\"><!-- wp:leco-cp/project-status-block {\"value\":\"3 of 6\",\"label\":\"Week\",\"backgroundColor\":\"leco-cp-secondary\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Thursday 7pm\",\"label\":\"Next Call\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Spring\",\"label\":\"Cohort\",\"backgroundColor\":\"leco-cp-tertiary\"} /--></div>\n<!-- /wp:leco-cp/project-status -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/phases-blocks\",\"name\":\"Phases Boxes\"},\"align\":\"full\",\"className\":\"main-content\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1024px\"}} -->\n<div class=\"wp-block-group alignfull main-content\"><!-- wp:leco-cp/search-bar {\"className\":\"wp-block-leco-cp-search-bar\"} /-->\n\n<!-- wp:leco-cp/phases {\"title\":\"Start here\",\"description\":\"Do these once, before the first call.\",\"phase\":\"\",\"uid\":0} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":0,\"phaseID\":\"1fc1ab20-fdf9-4980-b616-64d8551e1e83\",\"icon\":\"clipboard\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:gc-how-it-works}}\",\"status\":\"completed\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">How This Program Works</span><span class=\"description\">The shape of the six weeks.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":1,\"phaseID\":\"9ea65752-55ca-46c7-8bfb-9a0ea81e8fc1\",\"icon\":\"quill\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:gc-before-first-call}}\",\"status\":\"completed\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Before the First Call</span><span class=\"description\">Three questions and a bit of setup.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":2,\"phaseID\":\"3d08280c-fa9a-48e7-a1b3-b9d77ee72cb3\",\"icon\":\"chat\",\"moduleLinks\":[{\"linkUrl\":\"community-link\",\"linkTitle\":\"Open the group space\"},{\"linkUrl\":\"calendar-link\",\"linkTitle\":\"Add the calls to your calendar\"}],\"textAbove\":\"\\u003cp\\u003eThe group space is for questions, progress, and whatever you said you'd do this week. Post there rather than saving it up for the call.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Point these at wherever your group actually talks, whether that's Circle, Slack, a Facebook group or a WhatsApp thread, and at a calendar invite for the call series. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Join the Group</span><span class=\"description\">Where the conversation happens between calls.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"The six weeks\",\"description\":\"One call a week. Recordings go up the day after.\",\"phase\":\"\",\"uid\":1} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":3,\"phaseID\":\"2ae68284-c216-487c-a8ab-1f05212c53d3\",\"icon\":\"book-open\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:gc-week-1}}\",\"status\":\"completed\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 1: Getting Clear</span><span class=\"description\">What you actually want, in one sentence.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":4,\"phaseID\":\"955895a7-59b8-4d8e-be52-c3bc87a2d8a8\",\"icon\":\"book-open\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:gc-week-2}}\",\"status\":\"completed\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 2: Making It Real</span><span class=\"description\">Turning the goal into dated actions.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":5,\"phaseID\":\"48668215-30e5-433b-b7f3-4486e1f569a1\",\"icon\":\"book-open\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:gc-week-3}}\",\"status\":\"active\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 3: When It Gets Hard</span><span class=\"description\">What stops you, and how to interrupt it.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":6,\"phaseID\":\"22b270b6-9384-4257-961e-6af914e3117d\",\"icon\":\"book-open\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 4: Building the System</span><span class=\"description\">Making the work happen without deciding to.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":7,\"phaseID\":\"a392ce32-a0ad-4e9d-b725-55b3c71379b2\",\"icon\":\"book-open\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 5: Making It Stick</span><span class=\"description\">Holding the change when the program ends.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":8,\"phaseID\":\"9b7e41a0-bea6-4720-9c74-1b4870bd3e61\",\"icon\":\"book-open\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Week 6: Where You Go Next</span><span class=\"description\">What to carry forward, and what to drop.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:block {\"ref\":\"{{pattern:gc-resources-and-next-steps}}\"} /--></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/call-to-action\",\"name\":\"Call To Action\"},\"align\":\"full\",\"className\":\"cta-section\",\"backgroundColor\":\"leco-cp-primary\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull cta-section has-leco-cp-primary-background-color has-background\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"has-large-font-size\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"2rem\"}}},\"fontSize\":\"x-large\"} -->\n<p class=\"has-text-align-center has-large-font-size has-x-large-font-size\" style=\"margin-bottom:2rem\">Stuck on something this week?</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">Ask in the group</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/footer-contact\",\"name\":\"Footer Contact\"},\"align\":\"full\",\"className\":\"contacts\",\"backgroundColor\":\"leco-cp-tertiary\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull contacts has-leco-cp-tertiary-background-color has-background\"><!-- wp:list {\"fontSize\":\"small\"} -->\n<ul class=\"wp-block-list has-small-font-size\"><!-- wp:list-item -->\n<li>Add your phone number</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Add your email address</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Powered by <a href=\"https://www.client-portal.io/\" target=\"_blank\" rel=\"noopener noreferrer\">Client Portal</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->",
