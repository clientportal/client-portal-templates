        "title": "Online Course",
        "post_content": "<!-- wp:cover {\"overlayColor\":\"leco-cp-primary\",\"isUserOverlayColor\":true,\"contentPosition\":\"center center\",\"isDark\":false,\"tagName\":\"header\",\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/header\",\"name\":\"Header\"},\"align\":\"full\",\"className\":\"title-section\"} -->\n<header class=\"wp-block-cover alignfull is-light title-section\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-leco-cp-primary-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:leco-cp/header-logo {\"logo\":{\"id\":\"{{attachment:content_0}}\",\"title\":\"Client Portal Logo - Dark\",\"filename\":\"Client-Portal-Logo-Dark.png\",\"url\":\"{{attachment_url:content_0}}\",\"link\":\"http://wordpress.test/?attachment_id=44\",\"alt\":\"\",\"author\":\"1\",\"description\":\"\",\"caption\":\"\",\"name\":\"client-portal-logo-dark\",\"status\":\"inherit\",\"uploadedTo\":42,\"date\":\"2026-02-02T19:27:55.000Z\",\"modified\":\"2026-02-02T19:27:55.000Z\",\"menuOrder\":0,\"mime\":\"image/png\",\"type\":\"image\",\"subtype\":\"png\",\"icon\":\"http://wordpress.test/wp-includes/images/media/default.svg\",\"dateFormatted\":\"February 2, 2026\",\"nonces\":{\"update\":\"26db441985\",\"delete\":\"e202fa9581\",\"edit\":\"3397531a5d\"},\"editLink\":\"http://wordpress.test/wp-admin/post.php?post=44\\u0026action=edit\",\"meta\":false,\"authorName\":\"lauradunn\",\"authorLink\":\"http://wordpress.test/wp-admin/profile.php\",\"uploadedToTitle\":\"Your Portal Name Here\",\"uploadedToLink\":\"http://wordpress.test/wp-admin/post.php?post=42\\u0026action=edit\",\"filesizeInBytes\":11359,\"filesizeHumanReadable\":\"11 KB\",\"context\":\"\",\"height\":264,\"width\":1364,\"orientation\":\"landscape\",\"sizes\":{\"thumbnail\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-150x150.png\",\"height\":150,\"width\":150,\"orientation\":\"landscape\"},\"medium\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-300x58.png\",\"height\":58,\"width\":300,\"orientation\":\"landscape\"},\"large\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-1024x198.png\",\"height\":198,\"width\":1024,\"orientation\":\"landscape\"},\"full\":{\"url\":\"{{attachment_url:content_0}}\",\"height\":264,\"width\":1364,\"orientation\":\"landscape\"}},\"compat\":{\"item\":\"\",\"meta\":\"\"}},\"fixedWidth\":true} /-->\n\n<!-- wp:post-title /-->\n\n<!-- wp:navigation {\"ref\":\"{{navigation:leco-cp-navigation}}\"} /--></div>\n<!-- /wp:group --></div></header>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"className\":\"content-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group content-section\"><!-- wp:paragraph -->\n<p>This is your resource hub. Session recordings, worksheets, templates and reference material all live here, sorted by module.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">How it works</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>🔓 A new module opens up as we get to it, so the list grows as you go</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>⏳ Modules you haven't reached yet are greyed out</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>🎥 Recordings go up within a day of each session</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>📚 Everything stays available after the course finishes</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:leco-cp/general-information {\"insertBlocks\":false,\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/general-information\",\"name\":\"General Information\"}} /-->\n\n<!-- wp:leco-cp/project-status {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/project-status\",\"name\":\"Show project status\"}} -->\n<div class=\"wp-block-leco-cp-project-status alignwide leco-cp-cols-3 leco-cp-container\"><!-- wp:leco-cp/project-status-block {\"value\":\"2 of 4 modules\",\"label\":\"Progress\",\"backgroundColor\":\"leco-cp-secondary\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Thursday 7pm\",\"label\":\"Next session\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Yours to keep\",\"label\":\"Access\",\"backgroundColor\":\"leco-cp-tertiary\"} /--></div>\n<!-- /wp:leco-cp/project-status -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/phases-blocks\",\"name\":\"Phases Boxes\"},\"align\":\"full\",\"className\":\"main-content\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1024px\"}} -->\n<div class=\"wp-block-group alignfull main-content\"><!-- wp:leco-cp/search-bar {\"className\":\"wp-block-leco-cp-search-bar\"} /-->\n\n<!-- wp:leco-cp/phases {\"title\":\"Getting started\",\"description\":\"Everything you need to get set up.\",\"phase\":\"\",\"uid\":0} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":0,\"phaseID\":\"925399e0-842a-457e-9fb1-a595aa63964b\",\"icon\":\"clipboard\",\"status\":\"completed\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:online-course-crs-welcome}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Welcome and how this works</span><span class=\"description\">How the course runs, and where things live.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":1,\"phaseID\":\"5ae0c193-a397-4dd7-8bf6-b47247adfd28\",\"icon\":\"settings\",\"status\":\"completed\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:online-course-crs-tools}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Recommended tools</span><span class=\"description\">What past groups ended up using.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Module 1: Clients\",\"description\":\"Finding and qualifying the right clients.\",\"phase\":\"\",\"uid\":1} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":2,\"phaseID\":\"f4252c0c-f220-416e-b106-3705c3d7e417\",\"icon\":\"book-open\",\"status\":\"completed\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:online-course-crs-module-1}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Session recording</span><span class=\"description\">Who you work best with, and why.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":3,\"phaseID\":\"d519d4f1-33c5-4e4d-a702-af26c8b22b70\",\"icon\":\"book\",\"status\":\"completed\",\"moduleType\":\"module-files\",\"moduleFiles\":[{\"id\":\"{{attachment:content_1}}\",\"url\":\"{{attachment_url:content_1}}\",\"title\":\"Ideal client worksheet\"},{\"id\":\"{{attachment:content_2}}\",\"url\":\"{{attachment_url:content_2}}\",\"title\":\"Discovery call script\"}],\"textAbove\":\"\\u003cp\\u003eDo the worksheet first. The call script is easier to use once you know who you're trying to find.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Worksheets and templates</span><span class=\"description\">The ideal client worksheet and call script.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Module 2: Systems\",\"description\":\"Building processes you can hand over.\",\"phase\":\"\",\"uid\":2} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":4,\"phaseID\":\"b153956a-1a19-403e-b04f-5153c3831182\",\"icon\":\"book-open\",\"status\":\"active\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:online-course-crs-module-2}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Session recording</span><span class=\"description\">Mapping a job from enquiry to delivery.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":5,\"phaseID\":\"8376b1c5-e65e-49ff-9b82-9aea609545f0\",\"icon\":\"book\",\"status\":\"active\",\"moduleType\":\"module-files\",\"moduleFiles\":[{\"id\":\"{{attachment:content_3}}\",\"url\":\"{{attachment_url:content_3}}\",\"title\":\"Process mapping worksheet\"},{\"id\":\"{{attachment:content_4}}\",\"url\":\"{{attachment_url:content_4}}\",\"title\":\"Email template pack\"}],\"textAbove\":\"\\u003cp\\u003eStart with the process map, for one type of job. The email pack has the four emails you send on every job.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Worksheets and templates</span><span class=\"description\">Process map and the email pack.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":6,\"phaseID\":\"f3047ae1-2ae5-4cd3-bb76-469f275543d2\",\"icon\":\"upload\",\"status\":\"active\",\"moduleType\":\"module-client-uploads\",\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eDemo note:\\u003c/strong\\u003e This portal is public so you can look around, and Client Portal doesn't allow uploads on a public portal. In a real client portal this is where the upload box appears, and anything your client sends lands in the portal instead of your inbox.\\u003c/p\\u003e\",\"showTextBelow\":true,\"textAbove\":\"\\u003cp\\u003eUpload your process map before the next session and I'll go through a few of them on the call. It doesn't need to be tidy.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Upload your work</span><span class=\"description\">Send your process map over for feedback.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Module 3: Pricing\",\"description\":\"Setting your prices, and telling clients what they are.\",\"phase\":\"\",\"uid\":3} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":7,\"phaseID\":\"9732bf1c-4e54-43ba-af46-dd2b557b0dc9\",\"icon\":\"book-open\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Session recording</span><span class=\"description\">Opens after the live session.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":8,\"phaseID\":\"d380f0df-61c7-42ab-ab86-6032dcf2b09d\",\"icon\":\"book\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Worksheets and templates</span><span class=\"description\">Pricing calculator and proposal template.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Module 4: Growth\",\"description\":\"Planning ahead, and hiring for the first time.\",\"phase\":\"\",\"uid\":4} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":9,\"phaseID\":\"14040492-6274-429f-ae04-bd8aaaf5dfeb\",\"icon\":\"book-open\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Session recording</span><span class=\"description\">Opens after the live session.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":10,\"phaseID\":\"a4991b1e-27d3-4756-b7bf-e97ec4a0cb79\",\"icon\":\"book\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Worksheets and templates</span><span class=\"description\">Planning kit and hiring checklist.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Bonus materials\",\"description\":\"Extras, and somewhere to talk to each other.\",\"phase\":\"\",\"uid\":5} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":11,\"phaseID\":\"e81fe549-dace-411b-a7d3-a1f9c48a9f81\",\"icon\":\"book\",\"moduleType\":\"module-files\",\"moduleFiles\":[{\"id\":\"{{attachment:content_5}}\",\"url\":\"{{attachment_url:content_5}}\",\"title\":\"Client red flags guide\"},{\"id\":\"{{attachment:content_6}}\",\"url\":\"{{attachment_url:content_6}}\",\"title\":\"Reading list\"}],\"textAbove\":\"\\u003cp\\u003eThings I mention on the calls, kept here so you don't have to go back through a recording to find them.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Resource library</span><span class=\"description\">Reading and references from the calls.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":12,\"phaseID\":\"13240e9c-a803-4362-ad17-ce5e68019a4d\",\"icon\":\"quill\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:online-course-crs-feedback}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Share your feedback</span><span class=\"description\">Tell me what worked and what did not.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":13,\"phaseID\":\"b98add36-bd4e-4c31-9778-1c8a52bfef92\",\"icon\":\"chat\",\"moduleLinks\":[{\"linkUrl\":\"#\",\"linkTitle\":\"Open the group space\"},{\"linkUrl\":\"#\",\"linkTitle\":\"Introduce yourself\"}],\"textAbove\":\"\\u003cp\\u003eAsk questions, post what you're working on, and see what everyone else is doing. It goes quiet some weeks, so don't wait for someone else to post first.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Community</span><span class=\"description\">Where everyone talks between sessions.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/call-to-action\",\"name\":\"Call To Action\"},\"align\":\"full\",\"className\":\"cta-section\",\"backgroundColor\":\"leco-cp-primary\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull cta-section has-leco-cp-primary-background-color has-background\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"has-large-font-size\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"2rem\"}}},\"fontSize\":\"x-large\"} -->\n<p class=\"has-text-align-center has-large-font-size has-x-large-font-size\" style=\"margin-bottom:2rem\">Stuck on something?</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">Ask in the community</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/footer-contact\",\"name\":\"Footer Contact\"},\"align\":\"full\",\"className\":\"contacts\",\"backgroundColor\":\"leco-cp-tertiary\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull contacts has-leco-cp-tertiary-background-color has-background\"><!-- wp:list {\"fontSize\":\"small\"} -->\n<ul class=\"wp-block-list has-small-font-size\"><!-- wp:list-item -->\n<li>(123) 456-7890</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>hello@clientportal.io</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Powered by <a href=\"https://www.client-portal.io/\" target=\"_blank\" rel=\"noopener noreferrer\">Client Portal</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->",
