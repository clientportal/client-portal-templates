		"post_content": "<!-- wp:cover {\"overlayColor\":\"leco-cp-primary\",\"isUserOverlayColor\":true,\"contentPosition\":\"center center\",\"isDark\":false,\"tagName\":\"header\",\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/header\",\"name\":\"Header\"},\"align\":\"full\",\"className\":\"title-section\"} -->\n<header class=\"wp-block-cover alignfull is-light title-section\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-leco-cp-primary-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:leco-cp/header-logo /-->\n\n<!-- wp:post-title /-->\n\n<!-- wp:navigation {\"ref\":\"{{navigation:leco-cp-navigation}}\"} /--></div>\n<!-- /wp:group --></div></header>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"className\":\"content-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group content-section\"><!-- wp:paragraph -->\n<p>This is your resource hub. Session recordings, worksheets, templates and reference material all live here, sorted by module.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">How it works</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>A new module opens up as we get to it, so the list grows as you go</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Modules you haven't reached yet are greyed out</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Recordings go up within a day of each session</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Everything stays available after the course finishes</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:leco-cp/general-information {\"insertBlocks\":false,\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/general-information\",\"name\":\"General Information\"}} /-->\n\n<!-- wp:leco-cp/project-status {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/project-status\",\"name\":\"Show project status\"}} -->\n<div class=\"wp-block-leco-cp-project-status alignwide leco-cp-cols-3 leco-cp-container\"><!-- wp:leco-cp/project-status-block {\"value\":\"2 of 4 modules\",\"label\":\"Progress\",\"backgroundColor\":\"leco-cp-secondary\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Thursday 7pm\",\"label\":\"Next Session\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Yours to keep\",\"label\":\"Access\",\"backgroundColor\":\"leco-cp-tertiary\"} /--></div>\n<!-- /wp:leco-cp/project-status -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/phases-blocks\",\"name\":\"Phases Boxes\"},\"align\":\"full\",\"className\":\"main-content\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1024px\"}} -->\n<div class=\"wp-block-group alignfull main-content\"><!-- wp:leco-cp/search-bar {\"className\":\"wp-block-leco-cp-search-bar\"} /-->\n\n<!-- wp:leco-cp/phases {\"title\":\"Getting started\",\"description\":\"Everything you need to get set up.\",\"phase\":\"\",\"uid\":0} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":0,\"phaseID\":\"b3d33816-5a2c-417d-b122-26d1910230bc\",\"icon\":\"clipboard\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:crs-welcome}}\",\"status\":\"completed\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Welcome and How This Works</span><span class=\"description\">How the course runs, and where things live.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":1,\"phaseID\":\"456a5f2b-5dc2-474e-bbc2-e07c02a03e38\",\"icon\":\"settings\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:crs-tools}}\",\"status\":\"completed\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Recommended Tools</span><span class=\"description\">What past groups actually stuck with.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Module 1: Clients\",\"description\":\"Finding and qualifying the right clients.\",\"phase\":\"\",\"uid\":1} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":2,\"phaseID\":\"0e45345a-df00-4e2a-bf3d-1713e647e045\",\"icon\":\"book-open\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:crs-module-1}}\",\"status\":\"completed\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Session Recording</span><span class=\"description\">Who you work best with, and why.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":3,\"phaseID\":\"698d01d9-1f17-4317-8e5e-e0e5acdfe2fa\",\"icon\":\"book\",\"moduleType\":\"module-files\",\"status\":\"completed\",\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e This module ships empty. Attach the worksheets for this module, or switch it to a URLs module if your files live somewhere else. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Worksheets and Templates</span><span class=\"description\">The ideal client worksheet and call script.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Module 2: Systems\",\"description\":\"Building processes you can hand over.\",\"phase\":\"\",\"uid\":2} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":4,\"phaseID\":\"caa2ef33-3347-4920-aa0e-fc8e0f70a6d9\",\"icon\":\"book-open\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:crs-module-2}}\",\"status\":\"active\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Session Recording</span><span class=\"description\">Mapping a job from enquiry to delivery.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":5,\"phaseID\":\"88a55ff7-7946-442e-bfa3-b142c1a99d91\",\"icon\":\"book\",\"moduleType\":\"module-files\",\"status\":\"active\",\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e This module ships empty. Attach the worksheets for this module, or switch it to a URLs module if your files live somewhere else. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Worksheets and Templates</span><span class=\"description\">Process map and the email pack.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":6,\"phaseID\":\"ca39b83b-614c-4c8f-9ccc-d471dc6f852e\",\"icon\":\"upload\",\"moduleType\":\"module-client-uploads\",\"status\":\"active\",\"textAbove\":\"\\u003cp\\u003eUpload your process map before the next session and I'll go through a few of them live. Rough is fine, and more useful than polished.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Uploads land in the portal rather than your inbox. Delete this module if you don't review work between sessions. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Upload Your Work</span><span class=\"description\">Send your process map over for feedback.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Module 3: Pricing\",\"description\":\"Charging properly, and saying it out loud.\",\"phase\":\"\",\"uid\":3} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":7,\"phaseID\":\"63e2b6d4-c7ed-4ff1-8a74-a34fb31d6144\",\"icon\":\"book-open\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Session Recording</span><span class=\"description\">Opens after the live session.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":8,\"phaseID\":\"88975d2e-c98a-48bf-9daa-4aee6a070c4a\",\"icon\":\"book\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Worksheets and Templates</span><span class=\"description\">Pricing calculator and proposal template.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Module 4: Growth\",\"description\":\"Getting bigger without it getting worse.\",\"phase\":\"\",\"uid\":4} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":9,\"phaseID\":\"2cc9ab6c-d51a-4868-9287-7af0635c5511\",\"icon\":\"book-open\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Session Recording</span><span class=\"description\">Opens after the live session.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":10,\"phaseID\":\"4a4a5b1f-1360-4d6f-8cd5-5453e28708e5\",\"icon\":\"book\",\"status\":\"inactive\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Worksheets and Templates</span><span class=\"description\">Planning kit and hiring checklist.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:block {\"ref\":\"{{pattern:crs-bonus-materials}}\"} /--></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/call-to-action\",\"name\":\"Call To Action\"},\"align\":\"full\",\"className\":\"cta-section\",\"backgroundColor\":\"leco-cp-primary\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull cta-section has-leco-cp-primary-background-color has-background\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"has-large-font-size\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"2rem\"}}},\"fontSize\":\"x-large\"} -->\n<p class=\"has-text-align-center has-large-font-size has-x-large-font-size\" style=\"margin-bottom:2rem\">Stuck on something?</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">Ask in the community</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/footer-contact\",\"name\":\"Footer Contact\"},\"align\":\"full\",\"className\":\"contacts\",\"backgroundColor\":\"leco-cp-tertiary\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull contacts has-leco-cp-tertiary-background-color has-background\"><!-- wp:list {\"fontSize\":\"small\"} -->\n<ul class=\"wp-block-list has-small-font-size\"><!-- wp:list-item -->\n<li>Add your phone number</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Add your email address</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Powered by <a href=\"https://www.client-portal.io/\" target=\"_blank\" rel=\"noopener noreferrer\">Client Portal</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->",
