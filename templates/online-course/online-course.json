			"post_name": "crs-bonus-materials",
			"post_content": "<!-- wp:leco-cp/phases {\"title\":\"Bonus materials\",\"description\":\"Extras, and somewhere to talk to each other.\",\"phase\":\"\",\"uid\":5} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":11,\"phaseID\":\"78dcd240-3a50-4b76-9f18-89a1443f80fd\",\"icon\":\"book\",\"moduleType\":\"module-files\",\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e This module ships empty. Attach the extras you hand out, or switch it to a URLs module and point at a reading list. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Resource Library</span><span class=\"description\">Reading and references worth keeping.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":12,\"phaseID\":\"7628d1da-7e12-4596-b661-dec79f962bc2\",\"icon\":\"quill\",\"moduleLinks\":[{\"linkUrl\":\"feedback-link\",\"linkTitle\":\"Course feedback form\"},{\"linkUrl\":\"testimonial-link\",\"linkTitle\":\"Leave a testimonial\"}],\"textAbove\":\"\\u003cp\\u003eTwo minutes, and it shapes the next run of this course. The second link is if you'd be happy for me to quote you.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Point these at your own form and testimonial collector. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Share Your Feedback</span><span class=\"description\">Tell me what worked and what did not.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":13,\"phaseID\":\"ca57593a-9300-4bcb-bdd6-2ac2dbad603c\",\"icon\":\"chat\",\"moduleLinks\":[{\"linkUrl\":\"community-link\",\"linkTitle\":\"Open the group space\"},{\"linkUrl\":\"intros-link\",\"linkTitle\":\"Introduce yourself\"}],\"textAbove\":\"\\u003cp\\u003eAsk questions, share what you're working on, and have a look at what everyone else is doing. Quieter than it looks; people mostly need a reason to post.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Point these at wherever your group actually talks. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\n\\n\\u003cstrong\\u003e⚡️ Quick tip:\\u003c/strong\\u003e Leave the later modules set to Inactive and switch them on as you go. The greyed out rows tell people the course is still running without you writing an email about it, and nobody can jump ahead to a recording that doesn't exist yet.\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Community</span><span class=\"description\">Where everyone talks between sessions.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->",
			"post_status": "publish"
		}
	]
}
