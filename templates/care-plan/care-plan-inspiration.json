        "title": "Care Plan",
        "post_content": "<!-- wp:cover {\"overlayColor\":\"leco-cp-primary\",\"isUserOverlayColor\":true,\"contentPosition\":\"center center\",\"isDark\":false,\"tagName\":\"header\",\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/header\",\"name\":\"Header\"},\"align\":\"full\",\"className\":\"title-section\"} -->\n<header class=\"wp-block-cover alignfull is-light title-section\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-leco-cp-primary-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:leco-cp/header-logo {\"logo\":{\"id\":\"{{attachment:content_0}}\",\"title\":\"Client Portal Logo - Dark\",\"filename\":\"Client-Portal-Logo-Dark.png\",\"url\":\"{{attachment_url:content_0}}\",\"link\":\"http://wordpress.test/?attachment_id=44\",\"alt\":\"\",\"author\":\"1\",\"description\":\"\",\"caption\":\"\",\"name\":\"client-portal-logo-dark\",\"status\":\"inherit\",\"uploadedTo\":42,\"date\":\"2026-02-02T19:27:55.000Z\",\"modified\":\"2026-02-02T19:27:55.000Z\",\"menuOrder\":0,\"mime\":\"image/png\",\"type\":\"image\",\"subtype\":\"png\",\"icon\":\"http://wordpress.test/wp-includes/images/media/default.svg\",\"dateFormatted\":\"February 2, 2026\",\"nonces\":{\"update\":\"26db441985\",\"delete\":\"e202fa9581\",\"edit\":\"3397531a5d\"},\"editLink\":\"http://wordpress.test/wp-admin/post.php?post=44\\u0026action=edit\",\"meta\":false,\"authorName\":\"lauradunn\",\"authorLink\":\"http://wordpress.test/wp-admin/profile.php\",\"uploadedToTitle\":\"Your Portal Name Here\",\"uploadedToLink\":\"http://wordpress.test/wp-admin/post.php?post=42\\u0026action=edit\",\"filesizeInBytes\":11359,\"filesizeHumanReadable\":\"11 KB\",\"context\":\"\",\"height\":264,\"width\":1364,\"orientation\":\"landscape\",\"sizes\":{\"thumbnail\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-150x150.png\",\"height\":150,\"width\":150,\"orientation\":\"landscape\"},\"medium\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-300x58.png\",\"height\":58,\"width\":300,\"orientation\":\"landscape\"},\"large\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-1024x198.png\",\"height\":198,\"width\":1024,\"orientation\":\"landscape\"},\"full\":{\"url\":\"{{attachment_url:content_0}}\",\"height\":264,\"width\":1364,\"orientation\":\"landscape\"}},\"compat\":{\"item\":\"\",\"meta\":\"\"}},\"fixedWidth\":true} /-->\n\n<!-- wp:post-title /-->\n\n<!-- wp:navigation {\"ref\":\"{{navigation:leco-cp-navigation}}\"} /--></div>\n<!-- /wp:group --></div></header>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"className\":\"content-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group content-section\"><!-- wp:paragraph -->\n<p>This is where your care plan lives. What it covers, what we've done lately, and how to reach us when you want something changed.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">The short version</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>💾 Your site's backed up every day and updated every week</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>👀 We watch it around the clock, so you don't have to</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>📬 A report lands in your inbox at the start of every month</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>✏️ Small changes are included, and you send them from here</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Jamie Rivera looks after your plan. If you're not sure where something goes, email <a href=\"mailto:hello@clientportal.io\">hello@clientportal.io</a> and it'll get to the right person.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:leco-cp/general-information {\"insertBlocks\":false,\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/general-information\",\"name\":\"General Information\"}} /-->\n\n<!-- wp:leco-cp/project-status {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/project-status\",\"name\":\"Show project status\"}} -->\n<div class=\"wp-block-leco-cp-project-status alignwide leco-cp-cols-3 leco-cp-container\"><!-- wp:leco-cp/project-status-block {\"value\":\"Essential\",\"label\":\"Your plan\",\"backgroundColor\":\"leco-cp-secondary\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"1 of 4\",\"label\":\"Changes this month\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"99.98%\",\"label\":\"Uptime this month\",\"backgroundColor\":\"leco-cp-tertiary\"} /--></div>\n<!-- /wp:leco-cp/project-status -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/phases-blocks\",\"name\":\"Phases Boxes\"},\"align\":\"full\",\"className\":\"main-content\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1024px\"}} -->\n<div class=\"wp-block-group alignfull main-content\"><!-- wp:leco-cp/search-bar {\"className\":\"wp-block-leco-cp-search-bar\"} /-->\n\n<!-- wp:leco-cp/phases {\"title\":\"Your plan\",\"description\":\"Everything the Essential plan covers.\",\"phase\":\"\",\"uid\":0} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":0,\"phaseID\":\"b01d1c94-e011-4710-ae05-3436df2803fa\",\"icon\":\"clipboard\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:care-plan-whats-included}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">What's included</span><span class=\"description\">Everything your plan covers, and how often.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":1,\"phaseID\":\"d215ef43-19bb-43a5-a026-4dc7283dc4ef\",\"icon\":\"globe\",\"moduleLinks\":[{\"linkUrl\":\"#\",\"linkTitle\":\"Your website\"},{\"linkUrl\":\"#\",\"linkTitle\":\"Log in to WordPress\"}],\"textAbove\":\"\\u003cp\\u003eYour live site, and the login you use to edit it. If a password stops working, tell us and we'll reset it the same day.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Your website details</span><span class=\"description\">Your site and your login, in one place.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":2,\"phaseID\":\"2d683ceb-1a77-4a1e-a494-f53a50c5b744\",\"icon\":\"role\",\"moduleType\":\"module-files\",\"moduleFiles\":[{\"id\":\"{{attachment:content_1}}\",\"url\":\"{{attachment_url:content_1}}\",\"title\":\"Care plan agreement, signed\"},{\"id\":\"{{attachment:content_2}}\",\"url\":\"{{attachment_url:content_2}}\",\"title\":\"Care plan terms\"}],\"textAbove\":\"\\u003cp\\u003eYour signed agreement, for reference. It sets out what's covered, what counts as a small change, and how cancelling works.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Your service agreement</span><span class=\"description\">Your signed plan and terms.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"This month\",\"description\":\"The August report is in. Send anything you want changed from here.\",\"phase\":\"\",\"uid\":1} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":3,\"phaseID\":\"551e2747-524f-4f63-aea7-58b65d95d486\",\"icon\":\"line-chart\",\"moduleLinks\":[{\"linkUrl\":\"#\",\"linkTitle\":\"This month's report\"},{\"linkUrl\":\"#\",\"linkTitle\":\"All past reports\"}],\"textAbove\":\"\\u003cp\\u003eYour report covers what got updated, what was backed up, how the site performed, and anything we fixed. It lands in the first week of the month.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Your monthly reports</span><span class=\"description\">What we did this month, and every month before.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":4,\"phaseID\":\"db7bed4c-a279-4ee1-ab71-cc8ce5edcc9a\",\"icon\":\"chat\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:care-plan-request-a-change}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Request a change</span><span class=\"description\">Tell us what you need changed.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":5,\"phaseID\":\"978480c3-5234-49e9-80d1-ee799153c88f\",\"icon\":\"upload\",\"moduleType\":\"module-client-uploads\",\"textAbove\":\"\\u003cp\\u003eIf a change needs images, copy, or a document, upload it here rather than emailing it.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eDemo note:\\u003c/strong\\u003e This portal is public so you can look around, and Client Portal doesn't allow uploads on a public portal. In a real client portal this is where the upload box appears, and anything your client sends lands in the portal instead of your inbox.\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Send us files</span><span class=\"description\">Images, copy, or anything else we need.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Resources and extras\",\"description\":\"Guides and answers, and how to add to your plan.\",\"phase\":\"\",\"uid\":2} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":6,\"phaseID\":\"0a912beb-1524-4c1f-abaa-6e3cf664cde9\",\"icon\":\"book-open\",\"moduleType\":\"module-files\",\"moduleFiles\":[{\"id\":\"{{attachment:content_3}}\",\"url\":\"{{attachment_url:content_3}}\",\"title\":\"How to add a blog post\"},{\"id\":\"{{attachment:content_4}}\",\"url\":\"{{attachment_url:content_4}}\",\"title\":\"How to update your opening hours\"}],\"textAbove\":\"\\u003cp\\u003eShort guides for the things people ask about most. If there's something you'd like a guide for, say so and we'll write one.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Guides and how-tos</span><span class=\"description\">Short guides for the things people ask about.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":7,\"phaseID\":\"3e5be231-d2e9-4ef8-9bcc-bec05ff588c2\",\"icon\":\"help\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:care-plan-common-questions}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Common questions</span><span class=\"description\">Answers to the things clients ask most.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":8,\"phaseID\":\"a8301592-6354-4a96-a6c2-139e0839db8a\",\"icon\":\"calendar\",\"moduleLinks\":[{\"linkUrl\":\"https://calendly.com\",\"linkTitle\":\"Book a time\"},{\"linkUrl\":\"#\",\"linkTitle\":\"What we can cover\"}],\"textAbove\":\"\\u003cp\\u003eSome things are quicker to talk through than to write down. Book a slot and we'll go through whatever you need.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003e⚡️ Quick tip:\\u003c/strong\\u003e A links module like this one sends clients out to your booking tool. If you'd rather they booked without leaving the portal, paste the scheduler's embed code into a content page and point the module at that instead: \\u003ca href=\\u0022https://client-portal.io/support/embed-a-calendar-in-client-portal-xr5xd\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eembed a calendar in Client Portal\\u003c/a\\u003e.\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Book a call</span><span class=\"description\">Grab a time if you'd rather talk.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":9,\"phaseID\":\"2dd73944-7343-426d-9634-2f5a8052e478\",\"icon\":\"lightbulb\",\"moduleLinks\":[{\"linkUrl\":\"#\",\"linkTitle\":\"See what else we offer\"},{\"linkUrl\":\"#\",\"linkTitle\":\"Ask for a price\"}],\"textAbove\":\"\\u003cp\\u003eBigger jobs, extra changes, or something new on the site. Tell us what you've got in mind and we'll price it.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003eEverything here is billed on top of your plan, so nothing changes on your monthly invoice unless you ask for it.\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Add more to your plan</span><span class=\"description\">Bigger jobs, priced separately.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/call-to-action\",\"name\":\"Call To Action\"},\"align\":\"full\",\"className\":\"cta-section\",\"backgroundColor\":\"leco-cp-primary\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull cta-section has-leco-cp-primary-background-color has-background\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"has-large-font-size\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"2rem\"}}},\"fontSize\":\"x-large\"} -->\n<p class=\"has-text-align-center has-large-font-size has-x-large-font-size\" style=\"margin-bottom:2rem\">Need something doing?</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">Get in touch</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/footer-contact\",\"name\":\"Footer Contact\"},\"align\":\"full\",\"className\":\"contacts\",\"backgroundColor\":\"leco-cp-tertiary\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull contacts has-leco-cp-tertiary-background-color has-background\"><!-- wp:list {\"fontSize\":\"small\"} -->\n<ul class=\"wp-block-list has-small-font-size\"><!-- wp:list-item -->\n<li>(123) 456-7890</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>hello@clientportal.io</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Powered by <a href=\"https://www.client-portal.io/\" target=\"_blank\" rel=\"noopener noreferrer\">Client Portal</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->",
