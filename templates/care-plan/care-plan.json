			"post_name": "cp-resources-and-extras",
			"post_content": "<!-- wp:leco-cp/phases {\"title\":\"Resources and extras\",\"description\":\"Guides, answers, and ways to get more done.\",\"phase\":\"\",\"uid\":2} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":6,\"phaseID\":\"686d762c-75fc-4c73-a977-26c6eb74fb37\",\"icon\":\"book-open\",\"moduleType\":\"module-files\",\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e This module ships empty. Attach the guides you already send by email, or switch it to a URLs module and point at your knowledge base instead. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Guides and How-tos</span><span class=\"description\">Short guides for the things people ask about.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":7,\"phaseID\":\"4948f727-9d75-4cda-85df-ce64b18aefa9\",\"icon\":\"help\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:cp-common-questions}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Common Questions</span><span class=\"description\">Answers to the things clients ask most.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":8,\"phaseID\":\"6023eb2b-7b4f-44e2-ad76-872021f35984\",\"icon\":\"calendar\",\"moduleLinks\":[{\"linkUrl\":\"booking-link\",\"linkTitle\":\"Book a time\"},{\"linkUrl\":\"call-topics-link\",\"linkTitle\":\"What we can cover\"}],\"textAbove\":\"\\u003cp\\u003eSome things are quicker to talk through than to write down. Book a slot and we will go through whatever you need.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Point the first link at your scheduling tool. If you would rather the client booked without leaving the portal, embed the scheduler in a content page instead: \\u003ca href=\\u0022https://client-portal.io/support/embed-a-calendar-in-client-portal-xr5xd\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eembed a calendar in Client Portal\\u003c/a\\u003e. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Book a Call</span><span class=\"description\">Grab a time if you would rather talk.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":9,\"phaseID\":\"76bc28d9-f150-4350-ba41-62c9ed7b674a\",\"icon\":\"lightbulb\",\"moduleLinks\":[{\"linkUrl\":\"addons-link\",\"linkTitle\":\"See what else we offer\"},{\"linkUrl\":\"quote-link\",\"linkTitle\":\"Ask for a price\"}],\"textAbove\":\"\\u003cp\\u003eBigger jobs, extra changes, or something new on the site. Tell us what you have in mind and we will price it.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003eEverything here is billed on top of your plan, so nothing changes on your monthly invoice unless you ask for it.\\n\\n\\u003cstrong\\u003e⚡️ Quick tip:\\u003c/strong\\u003e If you sell through WooCommerce, a client can buy a plan and have their portal built for them at checkout, with no setup from you. \\u003ca href=\\u0022https://client-portal.io/support/using-client-portal-with-woocommerce-rbwys\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eSelling with WooCommerce\\u003c/a\\u003e and \\u003ca href=\\u0022https://client-portal.io/support/automatic-portal-creation-let-clients-register-themselves-2al7w\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eautomatic portal creation\\u003c/a\\u003e.\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Add More to Your Plan</span><span class=\"description\">Extra hands when you need them.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->",
			"post_status": "publish"
		}
	]
}
