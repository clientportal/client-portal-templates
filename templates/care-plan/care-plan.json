		"title": "Care Plan Template",
		"post_content": "<!-- wp:cover {\"overlayColor\":\"leco-cp-primary\",\"isUserOverlayColor\":true,\"contentPosition\":\"center center\",\"isDark\":false,\"tagName\":\"header\",\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/header\",\"name\":\"Header\"},\"align\":\"full\",\"className\":\"title-section\"} -->\n<header class=\"wp-block-cover alignfull is-light title-section\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-leco-cp-primary-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:leco-cp/header-logo /-->\n\n<!-- wp:post-title /-->\n\n<!-- wp:navigation {\"ref\":\"{{navigation:leco-cp-navigation}}\"} /--></div>\n<!-- /wp:group --></div></header>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"className\":\"content-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group content-section\"><!-- wp:paragraph -->\n<p>This is where your care plan lives. What it covers, what we have done recently, and how to reach us when you need something changed.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">The short version</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Your site is backed up every day and updated every week</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>We watch it around the clock, so you do not have to</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>A report lands in your inbox at the start of every month</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Small changes are included, and you send them from here</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:leco-cp/general-information {\"insertBlocks\":false,\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/general-information\",\"name\":\"General Information\"}} /-->\n\n<!-- wp:leco-cp/project-status {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/project-status\",\"name\":\"Show project status\"}} -->\n<div class=\"wp-block-leco-cp-project-status alignwide leco-cp-cols-3 leco-cp-container\"><!-- wp:leco-cp/project-status-block {\"value\":\"Essential\",\"label\":\"Your Plan\",\"backgroundColor\":\"leco-cp-secondary\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"1 of 4 used\",\"label\":\"Changes This Month\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"99.98%\",\"label\":\"Uptime This Month\",\"backgroundColor\":\"leco-cp-tertiary\"} /--></div>\n<!-- /wp:leco-cp/project-status -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/phases-blocks\",\"name\":\"Phases Boxes\"},\"align\":\"full\",\"className\":\"main-content\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1024px\"}} -->\n<div class=\"wp-block-group alignfull main-content\"><!-- wp:leco-cp/search-bar {\"className\":\"wp-block-leco-cp-search-bar\"} /-->\n\n<!-- wp:leco-cp/phases {\"title\":\"Your plan\",\"description\":\"What you are paying for, and how often it happens.\",\"phase\":\"\",\"uid\":0} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":0,\"phaseID\":\"38d5c70a-8e7e-4433-bc1c-9cb464fccb16\",\"icon\":\"clipboard\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:cp-whats-included}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">What's Included</span><span class=\"description\">Everything your plan covers, and how often.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":1,\"phaseID\":\"72fc2b76-09c3-45f6-aa07-069f77940714\",\"icon\":\"globe\",\"moduleLinks\":[{\"linkUrl\":\"website-link\",\"linkTitle\":\"Your website\"},{\"linkUrl\":\"wp-login-link\",\"linkTitle\":\"Log in to WordPress\"}],\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Point these at the client's live site and their WordPress login. Delete the module if you would rather not surface the admin URL. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Your Website Details</span><span class=\"description\">Your site and your login, in one place.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":2,\"phaseID\":\"4492d38e-0682-49a4-b419-8394893c9860\",\"icon\":\"role\",\"moduleType\":\"module-files\",\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e This module ships empty. Attach the signed agreement and anything else they should keep, or switch it to a URLs module if your paperwork lives in a signing tool. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Your Service Agreement</span><span class=\"description\">Your signed plan and terms.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"This month\",\"description\":\"Your report, and anything you need us to change.\",\"phase\":\"\",\"uid\":1} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":3,\"phaseID\":\"0cd0e461-7c38-4712-9711-787a1bacd4fd\",\"icon\":\"line-chart\",\"moduleLinks\":[{\"linkUrl\":\"report-link\",\"linkTitle\":\"This month's report\"},{\"linkUrl\":\"reports-folder-link\",\"linkTitle\":\"All past reports\"}],\"textAbove\":\"\\u003cp\\u003eYour report covers what was updated, what was backed up, how the site performed, and anything we fixed. It lands in the first week of the month.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Point the first link at this month's report in your cloud storage and the second at the folder holding all of them, so the only thing to change each month is one URL. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Your Monthly Reports</span><span class=\"description\">What we did this month, and every month before.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":4,\"phaseID\":\"d2221a9c-b56e-4723-af08-05290c3d168c\",\"icon\":\"chat\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:cp-request-a-change}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Request a Change</span><span class=\"description\">Tell us what you need changed.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":5,\"phaseID\":\"33591f3a-5319-4509-afad-c20d89fa835a\",\"icon\":\"upload\",\"moduleType\":\"module-client-uploads\",\"textAbove\":\"\\u003cp\\u003eIf a change needs images, copy, or a document, upload it here and it comes straight to us. Nothing gets lost in an email thread.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Uploads land in the portal rather than your inbox. Delete this module if you would rather clients sent files another way. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Send Us Files</span><span class=\"description\">Images, copy, or anything else we need.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:block {\"ref\":\"{{pattern:cp-resources-and-extras}}\"} /--></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/call-to-action\",\"name\":\"Call To Action\"},\"align\":\"full\",\"className\":\"cta-section\",\"backgroundColor\":\"leco-cp-primary\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull cta-section has-leco-cp-primary-background-color has-background\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"has-large-font-size\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"2rem\"}}},\"fontSize\":\"x-large\"} -->\n<p class=\"has-text-align-center has-large-font-size has-x-large-font-size\" style=\"margin-bottom:2rem\">Need something doing?</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">Get in touch</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/footer-contact\",\"name\":\"Footer Contact\"},\"align\":\"full\",\"className\":\"contacts\",\"backgroundColor\":\"leco-cp-tertiary\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull contacts has-leco-cp-tertiary-background-color has-background\"><!-- wp:list {\"fontSize\":\"small\"} -->\n<ul class=\"wp-block-list has-small-font-size\"><!-- wp:list-item -->\n<li>Add your phone number</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Add your email address</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Powered by <a href=\"https://www.client-portal.io/\" target=\"_blank\" rel=\"noopener noreferrer\">Client Portal</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->",
		"post_name": "care-plan-template",
