        "title": "One to One Coaching",
        "post_content": "<!-- wp:cover {\"overlayColor\":\"leco-cp-primary\",\"isUserOverlayColor\":true,\"contentPosition\":\"center center\",\"isDark\":false,\"tagName\":\"header\",\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/header\",\"name\":\"Header\"},\"align\":\"full\",\"className\":\"title-section\"} -->\n<header class=\"wp-block-cover alignfull is-light title-section\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-leco-cp-primary-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:leco-cp/header-logo {\"logo\":{\"id\":\"{{attachment:content_0}}\",\"title\":\"Client Portal Logo - Dark\",\"filename\":\"Client-Portal-Logo-Dark.png\",\"url\":\"{{attachment_url:content_0}}\",\"link\":\"http://wordpress.test/?attachment_id=44\",\"alt\":\"\",\"author\":\"1\",\"description\":\"\",\"caption\":\"\",\"name\":\"client-portal-logo-dark\",\"status\":\"inherit\",\"uploadedTo\":42,\"date\":\"2026-02-02T19:27:55.000Z\",\"modified\":\"2026-02-02T19:27:55.000Z\",\"menuOrder\":0,\"mime\":\"image/png\",\"type\":\"image\",\"subtype\":\"png\",\"icon\":\"http://wordpress.test/wp-includes/images/media/default.svg\",\"dateFormatted\":\"February 2, 2026\",\"nonces\":{\"update\":\"26db441985\",\"delete\":\"e202fa9581\",\"edit\":\"3397531a5d\"},\"editLink\":\"http://wordpress.test/wp-admin/post.php?post=44\\u0026action=edit\",\"meta\":false,\"authorName\":\"lauradunn\",\"authorLink\":\"http://wordpress.test/wp-admin/profile.php\",\"uploadedToTitle\":\"Your Portal Name Here\",\"uploadedToLink\":\"http://wordpress.test/wp-admin/post.php?post=42\\u0026action=edit\",\"filesizeInBytes\":11359,\"filesizeHumanReadable\":\"11 KB\",\"context\":\"\",\"height\":264,\"width\":1364,\"orientation\":\"landscape\",\"sizes\":{\"thumbnail\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-150x150.png\",\"height\":150,\"width\":150,\"orientation\":\"landscape\"},\"medium\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-300x58.png\",\"height\":58,\"width\":300,\"orientation\":\"landscape\"},\"large\":{\"url\":\"http://wordpress.test/wp-content/uploads/2026/02/Client-Portal-Logo-Dark-1024x198.png\",\"height\":198,\"width\":1024,\"orientation\":\"landscape\"},\"full\":{\"url\":\"{{attachment_url:content_0}}\",\"height\":264,\"width\":1364,\"orientation\":\"landscape\"}},\"compat\":{\"item\":\"\",\"meta\":\"\"}},\"fixedWidth\":true} /-->\n\n<!-- wp:post-title /-->\n\n<!-- wp:navigation {\"ref\":\"{{navigation:leco-cp-navigation}}\"} /--></div>\n<!-- /wp:group --></div></header>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"className\":\"content-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group content-section\"><!-- wp:paragraph -->\n<p>This is where the work between our sessions lives. What you're focused on right now, what came out of the last call, and anything you'd like me to look at before the next one.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">How to use it</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>🧭 Check <strong>Where you are</strong> for what you're working on this week</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>📝 Send your check-in the day before we speak, so we start somewhere useful</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>📎 Upload anything you'd like me to read beforehand</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>📚 Everything else is here whenever you want it</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:leco-cp/general-information {\"insertBlocks\":false,\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/general-information\",\"name\":\"General Information\"}} /-->\n\n<!-- wp:leco-cp/project-status {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/project-status\",\"name\":\"Show project status\"}} -->\n<div class=\"wp-block-leco-cp-project-status alignwide leco-cp-cols-3 leco-cp-container\"><!-- wp:leco-cp/project-status-block {\"value\":\"4 of 12\",\"label\":\"Session\",\"backgroundColor\":\"leco-cp-secondary\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Thursday 10am\",\"label\":\"Next call\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Consistency\",\"label\":\"Current focus\",\"backgroundColor\":\"leco-cp-tertiary\"} /--></div>\n<!-- /wp:leco-cp/project-status -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/phases-blocks\",\"name\":\"Phases Boxes\"},\"align\":\"full\",\"className\":\"main-content\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1024px\"}} -->\n<div class=\"wp-block-group alignfull main-content\"><!-- wp:leco-cp/search-bar {\"className\":\"wp-block-leco-cp-search-bar\"} /-->\n\n<!-- wp:leco-cp/phases {\"title\":\"Start here\",\"description\":\"Read these once at the start.\",\"phase\":\"\",\"uid\":0} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":0,\"phaseID\":\"e06ed21b-c0a8-483f-8574-06c3dd27be21\",\"icon\":\"clipboard\",\"status\":\"completed\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:one-to-one-coaching-oc-how-coaching-works}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">How coaching works</span><span class=\"description\">How sessions run, and what I need from you.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":1,\"phaseID\":\"ce553e69-c48d-4a89-a3c5-174c73b4a989\",\"icon\":\"quill\",\"status\":\"completed\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:one-to-one-coaching-oc-your-goals}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Your goals</span><span class=\"description\">What you're working toward, in your own words.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":2,\"phaseID\":\"68b399cd-ad05-4ffd-b489-635850591412\",\"icon\":\"calendar\",\"moduleLinks\":[{\"linkUrl\":\"https://zoom.us\",\"linkTitle\":\"Join the session\"},{\"linkUrl\":\"https://calendly.com\",\"linkTitle\":\"Reschedule this week\"}],\"textAbove\":\"\\u003cp\\u003eWe meet at the same time every week and the link stays the same. If something comes up, use the second link to move the session rather than skip it.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Join your session</span><span class=\"description\">Same time every week.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Your sessions\",\"description\":\"What we agreed, and what happens before the next one.\",\"phase\":\"\",\"uid\":1} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":3,\"phaseID\":\"37284294-f5cb-415d-8490-bc6a3c329228\",\"icon\":\"finding\",\"dueDate\":true,\"moduleDueDate\":\"2026-09-10T10:00:00\",\"showMarkAsComplete\":\"show\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:one-to-one-coaching-oc-where-you-are}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Where you are</span><span class=\"description\">Your focus this week, and what you agreed to.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":4,\"phaseID\":\"26a17693-528b-4245-b385-5da08a064b73\",\"icon\":\"book-open\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:one-to-one-coaching-oc-session-notes}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Session notes</span><span class=\"description\">Everything we've covered, session by session.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":5,\"phaseID\":\"6409f3f4-f060-49a8-87b8-717b9749636f\",\"icon\":\"chat\",\"dueDate\":true,\"moduleDueDate\":\"2026-09-09T17:00:00\",\"showMarkAsComplete\":\"show\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:one-to-one-coaching-oc-your-check-in}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Your check-in</span><span class=\"description\">Five minutes, the day before we speak.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":6,\"phaseID\":\"db7c5b24-ddc9-43e4-af60-a114e60c0180\",\"icon\":\"upload\",\"moduleType\":\"module-client-uploads\",\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eDemo note:\\u003c/strong\\u003e This portal is public so you can look around, and Client Portal doesn't allow uploads on a public portal. In a real client portal this is where the upload box appears, and anything your client sends lands in the portal instead of your inbox.\\u003c/p\\u003e\",\"showTextBelow\":true,\"textAbove\":\"\\u003cp\\u003eAnything you'd like me to look at before the session goes here. Send it a day ahead if you can, so I've had time to read it.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Send me your work</span><span class=\"description\">Drafts, documents, anything you want me to read.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Resources and next steps\",\"description\":\"Use these whenever you like.\",\"phase\":\"\",\"uid\":2} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":7,\"phaseID\":\"97c771bd-b70e-42a0-9b12-a373f3cd4c12\",\"icon\":\"book\",\"moduleType\":\"module-files\",\"moduleFiles\":[{\"id\":\"{{attachment:content_1}}\",\"url\":\"{{attachment_url:content_1}}\",\"title\":\"Weekly review\"},{\"id\":\"{{attachment:content_2}}\",\"url\":\"{{attachment_url:content_2}}\",\"title\":\"Energy audit\"}],\"textAbove\":\"\\u003cp\\u003eThe two worksheets I hand out most. The weekly review is the one to keep doing after we finish.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Resource library</span><span class=\"description\">Worksheets and things worth reading.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":8,\"phaseID\":\"e23791cf-7fbf-40b9-b9a2-d71694083cb0\",\"icon\":\"lightbulb\",\"moduleLinks\":[{\"linkUrl\":\"#\",\"linkTitle\":\"The reading list\"},{\"linkUrl\":\"#\",\"linkTitle\":\"Tools worth using\"}],\"textAbove\":\"\\u003cp\\u003eNone of this is required. It's what I recommend most often, kept in one place.\\u003c/p\\u003e\",\"showTextAbove\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Reading and tools</span><span class=\"description\">What I recommend, and why.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":9,\"phaseID\":\"4f397b39-4437-4ee0-9aaf-f00922025c2d\",\"icon\":\"heart\",\"moduleLinks\":[{\"linkUrl\":\"#\",\"linkTitle\":\"Add extra sessions\"},{\"linkUrl\":\"#\",\"linkTitle\":\"Book an intensive\"}],\"textAbove\":\"\\u003cp\\u003eSome weeks need more than one call. Extra sessions can be added to your existing block, or booked as a longer intensive when something big is coming up.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003eAnything added here is billed separately from your current block.\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Add more support</span><span class=\"description\">Extra sessions when you need them.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/call-to-action\",\"name\":\"Call To Action\"},\"align\":\"full\",\"className\":\"cta-section\",\"backgroundColor\":\"leco-cp-primary\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull cta-section has-leco-cp-primary-background-color has-background\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"has-large-font-size\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"2rem\"}}},\"fontSize\":\"x-large\"} -->\n<p class=\"has-text-align-center has-large-font-size has-x-large-font-size\" style=\"margin-bottom:2rem\">Something come up before our next call?</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">Send me a message</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/footer-contact\",\"name\":\"Footer Contact\"},\"align\":\"full\",\"className\":\"contacts\",\"backgroundColor\":\"leco-cp-tertiary\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull contacts has-leco-cp-tertiary-background-color has-background\"><!-- wp:list {\"fontSize\":\"small\"} -->\n<ul class=\"wp-block-list has-small-font-size\"><!-- wp:list-item -->\n<li>(123) 456-7890</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>hello@clientportal.io</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Powered by <a href=\"https://www.client-portal.io/\" target=\"_blank\" rel=\"noopener noreferrer\">Client Portal</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->",
