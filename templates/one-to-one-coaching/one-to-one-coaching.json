		"title": "One to One Coaching Template",
		"post_content": "<!-- wp:cover {\"overlayColor\":\"leco-cp-primary\",\"isUserOverlayColor\":true,\"contentPosition\":\"center center\",\"isDark\":false,\"tagName\":\"header\",\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/header\",\"name\":\"Header\"},\"align\":\"full\",\"className\":\"title-section\"} -->\n<header class=\"wp-block-cover alignfull is-light title-section\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-leco-cp-primary-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:leco-cp/header-logo /-->\n\n<!-- wp:post-title /-->\n\n<!-- wp:navigation {\"ref\":\"{{navigation:leco-cp-navigation}}\"} /--></div>\n<!-- /wp:group --></div></header>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"className\":\"content-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group content-section\"><!-- wp:paragraph -->\n<p>This is where the work between our sessions lives. What you're focused on right now, what came out of the last call, and anything you'd like me to look at before the next one.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">How to use it</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Check <strong>Where you are</strong> for what you're working on this week</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Send your check-in the day before we speak, so we start somewhere useful</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Upload anything you'd like me to read beforehand</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Everything else is here whenever you want it</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:leco-cp/general-information {\"insertBlocks\":false,\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/general-information\",\"name\":\"General Information\"}} /-->\n\n<!-- wp:leco-cp/project-status {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/project-status\",\"name\":\"Show project status\"}} -->\n<div class=\"wp-block-leco-cp-project-status alignwide leco-cp-cols-3 leco-cp-container\"><!-- wp:leco-cp/project-status-block {\"value\":\"4 of 12\",\"label\":\"Session\",\"backgroundColor\":\"leco-cp-secondary\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Thursday 10am\",\"label\":\"Next Call\"} /-->\n\n<!-- wp:leco-cp/project-status-block {\"value\":\"Consistency\",\"label\":\"Current Focus\",\"backgroundColor\":\"leco-cp-tertiary\"} /--></div>\n<!-- /wp:leco-cp/project-status -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/phases-blocks\",\"name\":\"Phases Boxes\"},\"align\":\"full\",\"className\":\"main-content\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1024px\"}} -->\n<div class=\"wp-block-group alignfull main-content\"><!-- wp:leco-cp/search-bar {\"className\":\"wp-block-leco-cp-search-bar\"} /-->\n\n<!-- wp:leco-cp/phases {\"title\":\"Start here\",\"description\":\"Read once, then leave it alone.\",\"phase\":\"\",\"uid\":0} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":0,\"phaseID\":\"28f1f826-0a66-4735-b67c-8b33de079c84\",\"icon\":\"clipboard\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:oc-how-coaching-works}}\",\"status\":\"completed\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">How Coaching Works</span><span class=\"description\">The rhythm, and what I need from you.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":1,\"phaseID\":\"dee2fd8e-9c19-408f-b1d9-83644b174705\",\"icon\":\"quill\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:oc-your-goals}}\",\"status\":\"completed\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Your Goals</span><span class=\"description\">What you're working toward, in your own words.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":2,\"phaseID\":\"20416f76-6987-4e71-9132-ec9406c93668\",\"icon\":\"calendar\",\"moduleLinks\":[{\"linkUrl\":\"session-link\",\"linkTitle\":\"Join the session\"},{\"linkUrl\":\"reschedule-link\",\"linkTitle\":\"Reschedule this week\"}],\"textAbove\":\"\\u003cp\\u003eWe meet at the same time every week and the joining link never changes, so it's worth saving. If something comes up, move it rather than skipping it.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Point the first link at your recurring meeting room and the second at your scheduling tool. If you'd rather the client booked without leaving the portal, embed the scheduler in a content page instead: \\u003ca href=\\u0022https://client-portal.io/support/embed-a-calendar-in-client-portal-xr5xd\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eembed a calendar in Client Portal\\u003c/a\\u003e. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Join Your Session</span><span class=\"description\">Same time every week.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:leco-cp/phases {\"title\":\"Your sessions\",\"description\":\"What we agreed, and what happens before the next one.\",\"phase\":\"\",\"uid\":1} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":3,\"phaseID\":\"0c6bf6a6-aa3e-46e9-b46b-19d14eee7a89\",\"icon\":\"finding\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:oc-where-you-are}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Where You Are</span><span class=\"description\">Your focus this week, and what you agreed to.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":4,\"phaseID\":\"5c244177-b7a8-4294-9c3a-ae601e3a8154\",\"icon\":\"book-open\",\"moduleLinks\":[{\"linkUrl\":\"notes-link\",\"linkTitle\":\"Open your notes\"},{\"linkUrl\":\"recordings-link\",\"linkTitle\":\"Recordings of past sessions\"}],\"textAbove\":\"\\u003cp\\u003eNotes go up straight after each session, while it's still fresh. Older sessions stay there, so you can look back at where you were two months ago.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003eIf anything in the notes doesn't match what you remember agreeing, say so and I'll fix it.\\n\\n\\u003cstrong\\u003e⚡️ Quick tip:\\u003c/strong\\u003e Keep the running notes in a shared document rather than a content page. A document gives each session its own tab in the sidebar, so twelve weeks stays navigable instead of turning into one very long scroll, and you can write straight into it during the call. Leave the portal to hold the current focus, which is the part the client actually needs between sessions.\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Session Notes</span><span class=\"description\">Everything we've covered, session by session.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":5,\"phaseID\":\"1d6f3348-7e21-4247-84da-44bfee98651a\",\"icon\":\"chat\",\"moduleType\":\"module-content-page\",\"openTab\":\"no\",\"moduleContentPage\":\"{{content_page:oc-your-check-in}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Your Check-in</span><span class=\"description\">Five minutes, the day before we speak.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":6,\"phaseID\":\"b25f0cba-3d3d-4af3-869f-d4d29142622f\",\"icon\":\"upload\",\"moduleType\":\"module-client-uploads\",\"textAbove\":\"\\u003cp\\u003eAnything you'd like me to look at before the session goes here. Send it a day ahead if you can, so I've read it properly before we speak.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Uploads land in the portal rather than your inbox, which keeps a client file history in one place. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Send Me Your Work</span><span class=\"description\">Drafts, documents, anything you want me to read.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->\n\n<!-- wp:block {\"ref\":\"{{pattern:oc-resources-and-next-steps}}\"} /--></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/call-to-action\",\"name\":\"Call To Action\"},\"align\":\"full\",\"className\":\"cta-section\",\"backgroundColor\":\"leco-cp-primary\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull cta-section has-leco-cp-primary-background-color has-background\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"has-large-font-size\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"2rem\"}}},\"fontSize\":\"x-large\"} -->\n<p class=\"has-text-align-center has-large-font-size has-x-large-font-size\" style=\"margin-bottom:2rem\">Something come up before our next call?</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">Send me a message</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"leco-client-portal\"],\"patternName\":\"leco-cp/footer-contact\",\"name\":\"Footer Contact\"},\"align\":\"full\",\"className\":\"contacts\",\"backgroundColor\":\"leco-cp-tertiary\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull contacts has-leco-cp-tertiary-background-color has-background\"><!-- wp:list {\"fontSize\":\"small\"} -->\n<ul class=\"wp-block-list has-small-font-size\"><!-- wp:list-item -->\n<li>Add your phone number</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Add your email address</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Powered by <a href=\"https://www.client-portal.io/\" target=\"_blank\" rel=\"noopener noreferrer\">Client Portal</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->",
