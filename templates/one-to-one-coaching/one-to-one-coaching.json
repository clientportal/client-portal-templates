			"title": "Resources and next steps (1-1)",
			"post_name": "oc-resources-and-next-steps",
			"post_content": "<!-- wp:leco-cp/phases {\"title\":\"Resources and next steps\",\"description\":\"Yours to use whenever, not just on call days.\",\"phase\":\"\",\"uid\":2} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":7,\"phaseID\":\"c6b35a88-a676-48c2-85e1-b1aebde87258\",\"icon\":\"book\",\"moduleType\":\"module-files\",\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e This module ships empty. Attach the worksheets you send most often, or switch it to a URLs module and point at wherever you host them. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Resource Library</span><span class=\"description\">Worksheets and things worth reading.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":8,\"phaseID\":\"7079ea55-1b9e-47e4-b582-ef278709a001\",\"icon\":\"lightbulb\",\"moduleLinks\":[{\"linkUrl\":\"reading-link\",\"linkTitle\":\"The reading list\"},{\"linkUrl\":\"tools-link\",\"linkTitle\":\"Tools worth using\"}],\"textAbove\":\"\\u003cp\\u003eNothing here is required. It's what I find myself recommending most often, kept in one place so you don't have to ask twice.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003e\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Point these at your own list. A short annotated list beats a long one; clients read three things, not thirty. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Reading and Tools</span><span class=\"description\">What I recommend, and why.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":9,\"phaseID\":\"a4221a08-635d-49a7-8e1b-0519de217b85\",\"icon\":\"heart\",\"moduleLinks\":[{\"linkUrl\":\"sessions-link\",\"linkTitle\":\"Add extra sessions\"},{\"linkUrl\":\"intensive-link\",\"linkTitle\":\"Book an intensive\"}],\"textAbove\":\"\\u003cp\\u003eSome weeks need more than one call. Extra sessions can be added to your existing block, or booked as a longer intensive when something big is coming up.\\u003c/p\\u003e\",\"showTextAbove\":true,\"textBelow\":\"\\u003cp\\u003eAnything added here is billed separately from your current block.\\u003c/p\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Add More Support</span><span class=\"description\">Extra sessions when you need them.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->",
			"post_status": "publish"
		}
	]
}
