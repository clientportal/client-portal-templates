			"post_content": "<!-- wp:leco-cp/phases {\"title\":\"Useful Resources\",\"description\":\"Ways to reach us and a few things to make the project easier.\",\"phase\":\"PART 3\",\"uid\":2} -->\n<div class=\"leco-cp-cols-3 leco-cp-container leco-cp-phases-container\"><!-- wp:leco-cp/modules {\"uid\":7,\"phaseID\":\"29d47fb8-3a6d-47c2-a228-fbfd1501ca78\",\"icon\":\"chat\",\"openTab\":\"link\",\"moduleLinks\":[{\"linkTitle\":\"Your private Slack workspace\",\"linkUrl\":\"slack-link\"},{\"linkUrl\":\"slack-link\",\"linkTitle\":\"Join our public channel\"}],\"textBelow\":\"Slack is best for quick questions and day-to-day updates. For approvals or scope changes, please use email so we have a clear record.\\n\\n\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e Swap in your own invite, or your preferred chat tool. Remove if you do not use one. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Join Our Slack</span><span class=\"description\">The quickest way to reach us day to day.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":8,\"phaseID\":\"443dc2e7-d8aa-4334-8b2b-a644fdad2e21\",\"icon\":\"help\",\"moduleType\":\"module-content-page\",\"openTab\":\"content-page\",\"moduleContentPage\":\"{{content_page:help-and-faq-2}}\"} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Help and FAQ</span><span class=\"description\">Answers to the questions clients ask most.</span></div>\n<!-- /wp:leco-cp/modules -->\n\n<!-- wp:leco-cp/modules {\"uid\":9,\"phaseID\":\"9bf857bf-2cbd-43b7-8904-2af68b26610d\",\"icon\":\"settings\",\"openTab\":\"link\",\"moduleLinks\":[{\"linkTitle\":\"Figma\",\"linkUrl\":\"figma-link\"},{\"linkTitle\":\"Loom\",\"linkUrl\":\"loom-link\"},{\"linkTitle\":\"Notion\",\"linkUrl\":\"notion-link\"},{\"linkTitle\":\"Google Drive\",\"linkUrl\":\"google-link\"}],\"textBelow\":\"\\u003cstrong\\u003eSetup note:\\u003c/strong\\u003e List only the tools your client needs a login for. Fewer is better. \\u003ca href=\\u0022https://client-portal.io/support/add-text-above-or-below-a-module-l0gcs\\u0022 target=\\u0022_blank\\u0022 rel=\\u0022noopener noreferrer\\u0022\\u003eHow to edit or delete this note\\u003c/a\\u003e\",\"showTextBelow\":true} -->\n<div><span class=\"title\" style=\"color:#3c5063\">Recommended Tools</span><span class=\"description\">The handful of tools we use to work together.</span></div>\n<!-- /wp:leco-cp/modules --></div>\n<!-- /wp:leco-cp/phases -->",
